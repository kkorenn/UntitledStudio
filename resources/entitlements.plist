<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for the notarized build (scripts/dist.sh). -->
<plist version="1.0">
<dict>
    <!-- Recording from the microphone / audio interface inputs. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Load third-party AU / VST3 plugins, which are signed by other teams (or not at all). -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Some plugins (copy protection, JIT-based DSP) write executable memory; without this they crash on load. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
